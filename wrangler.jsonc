{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-lab",
  "main": "edge/worker.ts",
  "account_id": "2f01018126ee716e5c953470f2aef993",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "smart-lab.limeai.run", "custom_domain": true }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LABS", "class_name": "LabSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LabSession"] }],
  "observability": { "enabled": true }
}
